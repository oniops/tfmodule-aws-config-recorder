{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeliveryPutObject",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${central_config_bucket}/AWSLogs/${account_id}/Config/*"
    },
    {
      "Sid": "DeliveryGetBucketAcl",
      "Effect": "Allow",
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::${central_config_bucket}"
    }
  ]
}
